PORT=3001
# Origin(s) allowed to call the API directly (comma separated). Not needed when
# the frontend dev server proxies /api to this server.
CORS_ORIGIN=http://localhost:5173
# xAI key for the LLM chatbot fallback. Without it /api/ask answers "resting".
XAI_API_KEY=
# Postgres (Neon etc). If empty, an embedded PGLite database is used in ./.pglite
DATABASE_URL=
